# .editorconfig
# Tells every code editor how to indent and end lines in this project,
# so files look the same for everyone. See https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.md]
# Two trailing spaces mean a line break in Markdown, so keep them.
trim_trailing_whitespace = false
